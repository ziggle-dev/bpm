{
  "schemaVersion": 1,
  "id": "bpm",
  "version": "0.2.1",
  "name": "bpm",
  "description": "Visual scripting for automation: graphs run on the server, edited in-game, rendered in the world.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "bpm.BpmFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "bpm.BpmFabricClient"
      }
    ]
  },
  "depends": {
    "minecraft": ">=1.20.1 <1.20.2",
    "fabricloader": ">=0.15",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.10",
    "geckolib": ">=4.5"
  },
  "mixins": [
    "bpm.mixins.json"
  ]
}
